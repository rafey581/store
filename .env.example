# ---------- Database (Supabase Postgres) ----------
# Pooled connection (port 6543) used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------- App ----------
NEXT_PUBLIC_SITE_URL="https://yourstore.pk"
# openssl rand -base64 32
AUTH_SECRET=""
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""
# Signs mobile-app access tokens. openssl rand -base64 32
MOBILE_JWT_SECRET=""

# ---------- File storage (Supabase Storage) ----------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="product-images"
SUPABASE_PRIVATE_BUCKET="payment-proofs"
# Development only: store uploads on local disk when Supabase is not set
# ALLOW_LOCAL_STORAGE="1"

# ---------- Email (Resend) ----------
RESEND_API_KEY=""
EMAIL_FROM="My Store <orders@yourstore.pk>"

# ---------- Help for Developer ----------
NEXT_PUBLIC_DEVELOPER_SOLANA_ADDRESS=""

# ---------- Seed ----------
SEED_OWNER_EMAIL="owner@yourstore.pk"
SEED_OWNER_PASSWORD=""
SEED_STORE_NAME="My Store"
# SEED_DEMO="false"   # skip demo products/coupon/staff

# ---------- Payment gateways (keys only here, never in the database) ----------
# Each gateway: set *_ENV="production" when going live (default sandbox).
# URL variables are optional overrides; defaults are built in.

# Safepay (card) - https://getsafepay.com  (Developer > API keys, Endpoints)
SAFEPAY_ENV="sandbox"
SAFEPAY_API_KEY=""            # public merchant API key (sec_...)
SAFEPAY_SECRET_KEY=""         # merchant secret key
SAFEPAY_WEBHOOK_SECRET=""     # webhook shared secret
# SAFEPAY_API_BASE="https://sandbox.api.getsafepay.com"
# SAFEPAY_CHECKOUT_BASE="https://sandbox.api.getsafepay.com"

# PayFast Pakistan (card / bank account) - https://gopayfast.com
PAYFAST_ENV="sandbox"
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
PAYFAST_MERCHANT_NAME="My Store"
# PAYFAST_API_BASE="https://ipguat.apps.net.pk"
# PAYFAST_TOKEN_URL=""
# PAYFAST_POST_URL=""

# JazzCash (wallet) - https://sandbox.jazzcash.com.pk
JAZZCASH_ENV="sandbox"
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
# JAZZCASH_TXN_TYPE="MWALLET"   # empty = hosted page offers all options
# JAZZCASH_FORM_URL=""
# JAZZCASH_INQUIRY_URL=""

# Easypaisa / Easypay (wallet) - https://easypay.easypaisa.com.pk
EASYPAISA_ENV="sandbox"
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""         # 16 characters
EASYPAISA_USERNAME=""         # for the inquiry API
EASYPAISA_PASSWORD=""
EASYPAISA_ACCOUNT_NUM=""
# EASYPAISA_PAYMENT_METHOD="MA_PAYMENT_METHOD"   # MA_ wallet, CC_ card, OTC_
# EASYPAISA_INDEX_URL=""
# EASYPAISA_CONFIRM_URL=""
# EASYPAISA_INQUIRY_URL=""

# ---------- Push notifications (mobile admin app) ----------
# Optional: Expo access token if "enhanced push security" is enabled in Expo
EXPO_ACCESS_TOKEN=""
